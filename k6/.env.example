# Copie este arquivo para k6/.env e preencha os valores.
# k6/.env nunca é commitado (ver .gitignore).
#
# Uso:
#   source k6/.env && k6 run k6/load-test.js
#
# Para gerar tokens.json (necessário para teste multi-usuário):
#   Docker Compose: bash k6/create-users.sh   (AUTH_BASE_URL padrão já aponta pra localhost:8090)
#   Minikube: kubectl port-forward svc/auth-service 8090:8090 -n orderhub &
#             AUTH_BASE_URL=http://localhost:8090 bash k6/create-users.sh
export AUTH_ADMIN_API_KEY=changeme-admin-key

# URL do api-gateway (NodePort do Minikube ou http://localhost:8000 para Docker Compose)
export BASE_URL=http://<minikube-ip>:<nodeport>

# Token JWT de fallback — usado apenas quando tokens.json não existe.
# Obtenha via (registro é único, login pode ser repetido):
#   curl -s -X POST http://localhost:8090/auth/register -H "Content-Type: application/json" \
#     -d '{"email":"demo@orderhub.local","password":"demo1234","name":"Demo User"}'
#   curl -s -X POST http://localhost:8090/auth/login -H "Content-Type: application/json" \
#     -d '{"email":"demo@orderhub.local","password":"demo1234"}' | jq -r '.access_token'
export JWT_TOKEN=
