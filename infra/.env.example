# Copie este arquivo para .env na mesma pasta (infra/.env) e preencha com
# valores reais antes de rodar `docker compose up -d --build`.
# NUNCA commite o infra/.env — ele já está no .gitignore.

# PostgreSQL — um container por serviço (order-service, payment-service,
# auth-service), cada um com seu próprio banco/volume. Credenciais
# compartilhadas só por simplicidade de dev local; nada é acessado
# cross-container.
POSTGRES_DB=orderdb
POSTGRES_USER=orderdb
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433
# 5434 é evitado de propósito: colide com o Postgres do docker-compose.yml
# standalone do auth-service-go (Opção A do README dele), caso rode os dois
# ao mesmo tempo no host.
PAYMENT_POSTGRES_PORT=5436
AUTH_POSTGRES_PORT=5435

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=catalogdb
MONGO_PORT=27017

# Kafka — SASL/PLAIN required (broker has no unauthenticated listener; without
# valid credentials nothing can produce/consume, closing off forged events on
# order-events/payment-events). One password per service — generate real
# random values (e.g. `openssl rand -hex 16`), don't reuse these examples.
KAFKA_PORT=9092
KAFKA_ADMIN_PASSWORD=changeme
KAFKA_ORDER_SERVICE_PASSWORD=changeme
KAFKA_PAYMENT_SERVICE_PASSWORD=changeme
KAFKA_NOTIFICATION_SERVICE_PASSWORD=changeme

# Redis
REDIS_PORT=6379

# auth-service (substitui o Keycloak) — espera o repositório auth-service-go
# como diretório irmão de order-hub-application; ajuste o path se a sua
# estrutura for diferente.
AUTH_SERVICE_GO_PATH=../../auth-service-go
AUTH_SERVICE_PORT=8090
AUTH_ISSUER=orderhub-auth-service
AUTH_ADMIN_API_KEY=changeme-admin-key
# Login social (opcional, planejado para quando o frontend estiver pronto)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# payment-service (payment-service-go) — espera o repositório payment-service-go
# como diretório irmão de order-hub-application; ajuste o path se a sua
# estrutura for diferente.
PAYMENT_SERVICE_GO_PATH=../../payment-service-go
DLT_REPROCESS_INTERVAL_MS=60000
# Stripe sandbox — https://dashboard.stripe.com/test/apikeys e /test/webhooks
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
# Mercado Pago sandbox — https://www.mercadopago.com/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-changeme
MERCADOPAGO_WEBHOOK_SECRET=changeme
# order-hub-store (a store Next.js), pra onde o cliente é redirecionado depois
# do checkout — tem as páginas /checkout/success e /checkout/cancel. O
# api-gateway não serve páginas, só API — nunca aponte PAYMENT_SUCCESS_URL/
# PAYMENT_CANCEL_URL pra ele.
STOREFRONT_URL=http://localhost:3001
PAYMENT_SUCCESS_URL=http://localhost:3001/checkout/success
PAYMENT_CANCEL_URL=http://localhost:3001/checkout/cancel

# notification-service — SMTP (Gmail). MAIL_PASSWORD deve ser uma
# "App Password" gerada em myaccount.google.com, nunca a senha da conta.
MAIL_USERNAME=changeme@example.com
MAIL_PASSWORD=changeme

# Destinatário de demonstração: usado como fallback pelo notification-service
# apenas quando um evento chega sem e-mail do cliente (ex.: pedido criado sem
# passar pelo API Gateway).
DEMO_RECIPIENT_EMAIL=changeme@example.com

# payment-service (Go, repositório irmão) — Stripe e Mercado Pago em modo
# sandbox/teste. STRIPE_SECRET_KEY deve começar com sk_test_ (nunca use uma
# chave live aqui). MERCADOPAGO_ACCESS_TOKEN deve começar com TEST-.
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
MERCADOPAGO_ACCESS_TOKEN=TEST-changeme
MERCADOPAGO_WEBHOOK_SECRET=changeme

# Caminho relativo (a partir de infra/) do repositório payment-service-go.
# Padrão assume repositórios irmãos: .../order-hub-application e
# .../payment-service-go.
PAYMENT_SERVICE_GO_PATH=../../payment-service-go

# URL onde o order-hub-store (frontend) está rodando — é pra lá que a
# Stripe/Mercado Pago redirecionam o navegador depois do pagamento
# (PAYMENT_SUCCESS_URL/PAYMENT_CANCEL_URL). Ajuste se a porta do seu
# `npm run dev` for diferente de 3001.
STOREFRONT_URL=http://localhost:3001
